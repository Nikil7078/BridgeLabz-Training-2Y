import java.util.*;

class Main2 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] arr = new int[5];

        for (int i = 0; i < arr.length; i++) {
            arr[i] = sc.nextInt();
        }

        for (int i = 0; i < arr.length; i++) {
            if (arr[i] > 0) {
                if (arr[i] % 2 == 0)
                    System.out.println(arr[i] + " Even Positive");
                else
                    System.out.println(arr[i] + " Odd Positive");
            } else if (arr[i] < 0) {
                System.out.println(arr[i] + " Negative");
            } else {
                System.out.println(arr[i] + " Zero");
            }
        }

        if (arr[0] == arr[4]) System.out.println("Equal");
        else if (arr[0] > arr[4]) System.out.println("First is Greater");
        else System.out.println("Last is Greater");
    }
}
